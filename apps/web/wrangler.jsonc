{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "reading-list",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// The app is only reachable through the custom domain, where Cloudflare Access
	// sits in front of it. No workers.dev or preview URLs; those would skip Access
	// (requests without a valid Access JWT are rejected by the app anyway).
	// Workers Logs: request logs and uncaught exceptions in the dashboard
	// (Workers & Pages -> reading-list -> Logs). Free tier: 200k events/day.
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "reader.nelsonfamily.fyi",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "reading-list",
			"database_id": "4c01c8e0-d3c7-45ff-90f5-5f77365b674e",
			"migrations_dir": "../../migrations"
		}
	],
	// The feed fetcher also captures readable copies of saved links. After a
	// change the app nudges it (POST /archive/kick) so a new copy doesn't wait
	// for the next cron run. Deploy the fetcher before the first deploy with this.
	"services": [
		{
			"binding": "FETCHER",
			"service": "reading-list-fetcher"
		}
	],
	"vars": {
		// Zero Trust team domain (see docs/setup.md)
		"ACCESS_TEAM_DOMAIN": "https://abbyandpaulnelson.cloudflareaccess.com",
		// The Application Audience (AUD) tag from the Access application
		"ACCESS_AUD": "698fd1bbe8ac62dd487848814c2388bfe85d99b05a0eafc4c6d29b06a04dd987",
		// Local development only; set it in .dev.vars. Ignored in production builds.
		"DEV_USER_EMAIL": "panel@umich.edu"
	}
}
