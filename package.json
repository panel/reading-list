{
	"name": "reading-list",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
